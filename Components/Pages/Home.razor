@page "/"

<PageTitle>Milk &amp; Meadow | Premium Artisanal Ice Cream</PageTitle>

<div class="fade-in">

    <!-- 1. Hero -->
    <section class="relative min-h-[75vh] flex items-center justify-start">
        <div class="absolute inset-0 z-0 bg-charcoal">
            <img src="https://images.unsplash.com/photo-1563805042-7684c8e9e533?auto=format&fit=crop&q=80&w=2000" alt="Artisanal Ice Cream" class="w-full h-full object-cover opacity-70" />
            <div class="absolute inset-0 bg-gradient-to-r from-charcoal/90 via-charcoal/50 to-transparent"></div>
        </div>

        <div class="relative z-10 max-w-7xl mx-auto px-6 md:px-12 w-full text-cream py-24">
            <div class="max-w-2xl">
                <p class="text-xs md:text-sm tracking-[0.2em] font-medium mb-4 uppercase text-cream/80">Good Food, Better Company</p>
                <h1 class="font-serif text-5xl md:text-7xl mb-6 leading-tight text-white">A Fresh Take <br />on Local Flavors</h1>
                <p class="text-cream/90 text-lg mb-10 leading-relaxed font-light max-w-lg">
                    At Milk &amp; Meadow, we serve thoughtfully crafted scoops made from the finest local dairy. Whether it's a sunny afternoon or a sweet night out, our parlor brings people together around great ice cream.
                </p>
                <a href="/gallery" class="bg-cream text-charcoal px-8 py-4 text-sm font-medium hover:bg-white transition-colors inline-flex items-center group shadow-lg tracking-wide">
                    View Gallery
                    <svg class="w-4 h-4 ml-3 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                </a>
            </div>
        </div>
    </section>

    <!-- 2. Flavors -->
    <section class="bg-white py-24">
        <div class="max-w-7xl mx-auto px-6 md:px-12">

            <div class="mb-12 md:mb-16 md:flex md:justify-between md:items-end">
                <div class="max-w-2xl">
                    <h3 class="text-xs tracking-[0.2em] font-bold mb-3 uppercase text-charcoal-lighter">Menu Highlights</h3>
                    <h2 class="font-serif text-4xl md:text-5xl text-charcoal mb-4">Signature Flavors</h2>
                    <p class="text-charcoal-lighter font-light text-lg">From classic vanilla bean to seasonal fruit infusions, our menu is a celebration of bold, simple ingredients.</p>
                </div>
                <div class="mt-6 md:mt-0">
                    <a href="#" class="inline-flex items-center text-sm font-medium text-charcoal hover:text-charcoal-lighter transition-colors border-b border-charcoal pb-1">
                        Explore Full Menu
                        <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
                    </a>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
                <div class="group cursor-pointer">
                    <div class="overflow-hidden mb-6 aspect-[4/3]">
                        <img src="https://images.unsplash.com/photo-1570197781417-0a8237580532?auto=format&fit=crop&q=80&w=800" alt="Honeycomb Lavender" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
                    </div>
                    <h4 class="font-serif text-2xl text-charcoal mb-2">Honeycomb Lavender</h4>
                    <p class="text-charcoal-lighter font-light text-sm mb-3">Sweet local honeycomb folded into a delicate lavender-infused sweet cream base.</p>
                    <p class="font-medium text-charcoal">$6 <span class="text-xs text-charcoal-lighter font-normal">/ scoop</span></p>
                </div>

                <div class="group cursor-pointer">
                    <div class="overflow-hidden mb-6 aspect-[4/3]">
                        <img src="https://images.unsplash.com/photo-1559703248-dcaaec9fab78?auto=format&fit=crop&q=80&w=800" alt="Dark Chocolate Truffle" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
                    </div>
                    <h4 class="font-serif text-2xl text-charcoal mb-2">Dark Chocolate Truffle</h4>
                    <p class="text-charcoal-lighter font-light text-sm mb-3">Rich 70% dark cacao mixed with house-made fudge ribbons and dark chocolate shavings.</p>
                    <p class="font-medium text-charcoal">$7 <span class="text-xs text-charcoal-lighter font-normal">/ scoop</span></p>
                </div>

                <div class="group cursor-pointer">
                    <div class="overflow-hidden mb-6 aspect-[4/3]">
                        <img src="https://images.unsplash.com/photo-1497034825429-c343d7c6a68f?auto=format&fit=crop&q=80&w=800" alt="Strawberry Balsamic" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
                    </div>
                    <h4 class="font-serif text-2xl text-charcoal mb-2">Strawberry Balsamic</h4>
                    <p class="text-charcoal-lighter font-light text-sm mb-3">Freshly roasted summer strawberries balanced with an aged balsamic glaze swirl.</p>
                    <p class="font-medium text-charcoal">$6 <span class="text-xs text-charcoal-lighter font-normal">/ scoop</span></p>
                </div>
            </div>

        </div>
    </section>

    <!-- 3. About -->
    <section class="bg-cream-dark">
        <div class="grid grid-cols-1 lg:grid-cols-2">
            <div class="h-[50vh] lg:h-auto overflow-hidden">
                <img src="https://images.unsplash.com/photo-1558500904-e591780d603a?auto=format&fit=crop&q=80&w=1600" alt="Parlor Interior" class="w-full h-full object-cover" />
            </div>

            <div class="flex items-center justify-center p-12 md:p-24 bg-white">
                <div class="max-w-md">
                    <h3 class="text-xs tracking-[0.2em] font-bold mb-3 uppercase text-charcoal-lighter">Our Story</h3>
                    <h2 class="font-serif text-4xl md:text-5xl text-charcoal mb-6">More Than a Scoop</h2>

                    <p class="text-charcoal-lighter font-light text-base leading-relaxed mb-6">
                        Milk &amp; Meadow was born from a simple idea — that great ice cream, honest ingredients, and genuine hospitality can turn an ordinary day into something special.
                    </p>
                    <p class="text-charcoal-lighter font-light text-base leading-relaxed mb-8">
                        We're a neighborhood parlor, built on farm-fresh dairy, seasonal menus, and a passion for bringing people together over a shared love of sweets.
                    </p>

                    <a href="#" class="inline-flex items-center text-sm font-medium text-charcoal hover:text-charcoal-lighter transition-colors border-b border-charcoal pb-1">
                        Read Our Full Story
                        <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- 4. Features -->
    <section class="bg-cream">
        <div class="max-w-7xl mx-auto px-6 md:px-12 py-24">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-12 text-center divide-y md:divide-y-0 md:divide-x divide-cream-dark">

                <div class="flex flex-col items-center pt-8 md:pt-0 px-6">
                    <svg class="w-10 h-10 mb-6 text-charcoal" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" /></svg>
                    <h3 class="text-xs tracking-[0.2em] font-bold mb-3 uppercase text-charcoal">Fresh Ingredients</h3>
                    <p class="text-sm text-charcoal-lighter font-light">Locally sourced, seasonally inspired.</p>
                </div>

                <div class="flex flex-col items-center pt-8 md:pt-0 px-6">
                    <svg class="w-10 h-10 mb-6 text-charcoal" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1"><path stroke-linecap="round" stroke-linejoin="round" d="M14.25 9.75L16.5 12l-2.25 2.25m-4.5 0L7.5 12l2.25-2.25M6 20.25h12A2.25 2.25 0 0020.25 18V6A2.25 2.25 0 0018 3.75H6A2.25 2.25 0 003.75 6v12A2.25 2.25 0 006 20.25z" /></svg>
                    <h3 class="text-xs tracking-[0.2em] font-bold mb-3 uppercase text-charcoal">Crafted With Care</h3>
                    <p class="text-sm text-charcoal-lighter font-light">Every batch is made from scratch.</p>
                </div>

                <div class="flex flex-col items-center pt-8 md:pt-0 px-6">
                    <svg class="w-10 h-10 mb-6 text-charcoal" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1"><path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z" /></svg>
                    <h3 class="text-xs tracking-[0.2em] font-bold mb-3 uppercase text-charcoal">Warm Atmosphere</h3>
                    <p class="text-sm text-charcoal-lighter font-light">Good scoops bring people together.</p>
                </div>

            </div>
        </div>
    </section>

</div>