@page "/gallery"

<PageTitle>Gallery | Milk &amp; Meadow</PageTitle>

<div class="fade-in min-h-[80vh] bg-white">
    <div class="max-w-7xl mx-auto px-6 md:px-12 py-20">
        <div class="text-center mb-16">
            <h2 class="font-serif text-4xl md:text-5xl text-charcoal mb-4">Gallery</h2>
            <p class="text-charcoal-lighter font-light text-lg">A glimpse into our daily churns and happy moments.</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 md:gap-6 auto-rows-[250px] md:auto-rows-[300px]">
            <!-- Large feature image: Parlor Interior -->
            <div class="md:col-span-2 md:row-span-2 overflow-hidden bg-cream-dark group">
                <img src="https://cdn.mos.cms.futurecdn.net/ManNov2ntFvFZNwVnbMJ3f.jpg" alt="Modern parlor interior" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
            </div>
            
            <!-- Macro Texture -->
            <div class="overflow-hidden bg-cream-dark group">
                <img src="https://cloudfront.omsphoto.com/wp-content/uploads/2025/03/UDFQuakes_BlueMooCookieMonster_Macro_948.jpg" alt="Cookie monster ice cream texture" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
            </div>
            
            <!-- Waffle Cones -->
            <div class="overflow-hidden bg-cream-dark group">
                <img src="https://goodineverygrain.ca/wp-content/uploads/2021/06/Homemade-ice-cream-1024x683.jpg" alt="Fresh waffle cones" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
            </div>
            
            <!-- Vanilla Bean -->
            <div class="overflow-hidden bg-cream-dark group">
                <img src="https://catalystcupcakes.wordpress.com/wp-content/uploads/2011/09/vanilla_icecream.jpg" alt="Vanilla bean scoop with dark chocolate" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
            </div>
            
            <!-- Prep/Action Shot (Kept from original to complete the grid) -->
            <div class="md:col-span-2 overflow-hidden bg-cream-dark group">
                <img src="https://images.unsplash.com/photo-1560008581-09826d1de69e?auto=format&fit=crop&q=80&w=1200" alt="Ice cream prep" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
            </div>
        </div>
    </div>
</div>