@page "/gallery"

<PageTitle>Gallery | Milk &amp; Meadow</PageTitle>

<div class="fade-in min-h-[80vh] bg-white">
    <div class="max-w-7xl mx-auto px-6 md:px-12 py-20">
        <div class="text-center mb-16">
            <h2 class="font-serif text-4xl md:text-5xl text-charcoal mb-4">Gallery</h2>
            <p class="text-charcoal-lighter font-light text-lg">A glimpse into our daily churns and happy moments.</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 md:gap-6 auto-rows-[250px] md:auto-rows-[300px]">
            <!-- Large feature image -->
            <div class="md:col-span-2 md:row-span-2 overflow-hidden bg-cream-dark group">
                <img src="/images/shop.jpg" alt="Our shop" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
            </div>
            <div class="overflow-hidden bg-cream-dark group">
                <img src="/images/IceCreamCones.jpg" alt="Ice cream cones" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
            </div>
            <div class="overflow-hidden bg-cream-dark group">
                <img src="/images/strawberry.jpg" alt="Strawberry ice cream" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
            </div>
            <div class="overflow-hidden bg-cream-dark group">
                <img src="/images/vanilla_icecream.jpg" alt="Vanilla ice cream" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
            </div>
            <div class="md:col-span-2 overflow-hidden bg-cream-dark group">
                <img src="/images/BlueMooCookieMonster.jpg" alt="Blue Moo Cookie Monster ice cream" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
            </div>
        </div>
    </div>
</div>