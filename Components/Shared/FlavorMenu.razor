<div class="grid grid-cols-1 md:grid-cols-2 gap-x-16 gap-y-12">
    @foreach (var group in Groups)
    {
        <div>
            <h4 class="font-serif text-2xl text-charcoal mb-6 pb-3 border-b border-cream-dark">@group.Key</h4>
            <ul class="space-y-6">
                @foreach (var flavor in group)
                {
                    <li>
                        <div class="flex items-baseline gap-3">
                            <span class="font-medium text-charcoal">@flavor.Name</span>
                            <span class="flex-1 border-b border-dotted border-charcoal/30"></span>
                            <span class="font-medium text-charcoal">$@flavor.Price.ToString("0.00")</span>
                        </div>
                        <p class="text-sm text-charcoal-lighter font-light mt-1">@flavor.Description</p>
                        @if (flavor.Tags.Length > 0)
                        {
                            <div class="flex flex-wrap gap-2 mt-2">
                                @foreach (var tag in flavor.Tags)
                                {
                                    <span class="border border-cream-dark bg-cream px-2 py-0.5 text-[0.65rem] text-charcoal-lighter">@tag</span>
                                }
                            </div>
                        }
                    </li>
                }
            </ul>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public IEnumerable<IGrouping<string, Flavor>> Groups { get; set; } = default!;
}