<article class="group">
    <button type="button" data-dialog-open="flavor-@Flavor.Id"
            class="block w-full text-left cursor-pointer">
        <div class="overflow-hidden mb-6 aspect-[4/3] bg-cream-dark">
            <img src="@Flavor.ImageUrl" alt="@Flavor.Name" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
        </div>
        <h4 class="font-serif text-2xl text-charcoal mb-2">@Flavor.Name</h4>
        <p class="text-charcoal-lighter font-light text-sm mb-3">@Flavor.Description</p>
        <p class="font-medium text-charcoal">$@Flavor.Price.ToString("0.00") <span class="text-xs text-charcoal-lighter font-normal">/ scoop</span></p>
        <span class="mt-3 inline-block text-xs font-medium text-charcoal border-b border-charcoal pb-0.5 group-hover:text-charcoal-lighter">View details</span>
    </button>

    <dialog id="flavor-@Flavor.Id" class="p-0 w-[calc(100%-2rem)] max-w-lg bg-white text-charcoal shadow-2xl backdrop:bg-charcoal/70">
        <div class="relative">
            <button type="button" data-dialog-close aria-label="Close"
                    class="absolute top-3 right-3 w-9 h-9 flex items-center justify-center bg-white/90 hover:bg-white text-charcoal">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>

            <img src="@Flavor.ImageUrl" alt="@Flavor.Name" class="w-full aspect-[4/3] object-cover" />

            <div class="p-8">
                <p class="text-xs tracking-[0.2em] uppercase text-charcoal-lighter mb-2">@Flavor.Category</p>
                <h3 class="font-serif text-3xl mb-3">@Flavor.Name</h3>
                <p class="text-charcoal-lighter font-light leading-relaxed mb-4">@Flavor.Description</p>

                @if (Flavor.Tags.Length > 0)
                {
                    <div class="flex flex-wrap gap-2 mb-5">
                        @foreach (var tag in Flavor.Tags)
                        {
                            <span class="border border-cream-dark bg-cream px-3 py-1 text-xs text-charcoal-lighter">@tag</span>
                        }
                    </div>
                }

                <p class="font-medium mb-6">$@Flavor.Price.ToString("0.00") <span class="text-xs text-charcoal-lighter font-normal">/ scoop</span></p>

                <div class="flex flex-col sm:flex-row gap-3">
                    <a href="/book?flavor=@Uri.EscapeDataString(Flavor.Name)"
                       class="bg-charcoal text-cream px-6 py-3 text-sm font-medium text-center hover:bg-charcoal-light transition-colors">
                        Request for my cart
                    </a>
                    <button type="button" data-dialog-close
                            class="border border-charcoal px-6 py-3 text-sm font-medium hover:bg-charcoal hover:text-cream transition-colors">
                        Close
                    </button>
                </div>
            </div>
        </div>
    </dialog>
</article>

@code {
    [Parameter, EditorRequired] public Flavor Flavor { get; set; } = default!;
}